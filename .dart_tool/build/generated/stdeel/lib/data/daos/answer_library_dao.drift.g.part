// ignore_for_file: type=lint
mixin _$AnswerLibraryDaoMixin on DatabaseAccessor<AppDatabase> {
  $AnswerLibraryTable get answerLibrary => attachedDatabase.answerLibrary;
  AnswerLibraryDaoManager get managers => AnswerLibraryDaoManager(this);
}

class AnswerLibraryDaoManager {
  final _$AnswerLibraryDaoMixin _db;
  AnswerLibraryDaoManager(this._db);
  $$AnswerLibraryTableTableManager get answerLibrary =>
      $$AnswerLibraryTableTableManager(_db.attachedDatabase, _db.answerLibrary);
}
